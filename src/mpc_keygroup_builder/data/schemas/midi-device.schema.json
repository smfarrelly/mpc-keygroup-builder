{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smfarrelly/mpc-keygroup-builder/blob/main/src/mpc_keygroup_builder/data/schemas/midi-device.schema.json",
  "title": "External MIDI device definition",
  "type": "object",
  "required": ["schema_version", "id", "name", "kind"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "midi_channel": {"type": "integer", "minimum": 1, "maximum": 16},
    "sources": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "cc"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string"},
          "cc": {"type": "integer", "minimum": 0, "maximum": 127}
        },
        "additionalProperties": true
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "note"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string"},
          "note": {"type": "integer", "minimum": 0, "maximum": 127}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
