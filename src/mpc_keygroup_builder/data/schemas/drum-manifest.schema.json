{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smfarrelly/mpc-keygroup-builder/blob/main/src/mpc_keygroup_builder/data/schemas/drum-manifest.schema.json",
  "title": "MPC Drum Program build manifest",
  "type": "object",
  "anyOf": [{"required": ["pads"]}, {"required": ["extends"]}],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "extends": {"type": "string", "minLength": 1},
    "pads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pad"],
        "properties": {
          "pad": {"type": "integer", "minimum": 1, "maximum": 128},
          "sample": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
          "mute_group": {"type": "integer", "minimum": 0, "maximum": 32},
          "layers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["sample", "velocity_start", "velocity_end"],
              "properties": {
                "sample": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
                "velocity_start": {"type": "integer", "minimum": 0, "maximum": 127},
                "velocity_end": {"type": "integer", "minimum": 0, "maximum": 127}
              },
              "additionalProperties": false
            }
          }
        },
        "oneOf": [{"required": ["sample"]}, {"required": ["layers"]}],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
