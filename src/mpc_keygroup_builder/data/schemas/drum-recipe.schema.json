{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smfarrelly/mpc-keygroup-builder/blob/main/src/mpc_keygroup_builder/data/schemas/drum-recipe.schema.json",
  "title": "Semantic Drum pattern recipe",
  "type": "object",
  "required": ["schema_version", "id", "name", "bars", "steps_per_bar", "events"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "bars": {"type": "integer", "minimum": 1, "maximum": 64},
    "steps_per_bar": {"type": "integer", "minimum": 4, "multipleOf": 4},
    "swing": {"type": "number", "minimum": 0.5, "maximum": 0.75},
    "gate": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "channel": {"type": "integer", "minimum": 1, "maximum": 16},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "steps"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "steps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
          "velocity": {"type": "integer", "minimum": 1, "maximum": 127},
          "probability": {"type": "number", "minimum": 0, "maximum": 1},
          "humanize_velocity": {"type": "integer", "minimum": 0, "maximum": 63},
          "selection": {"enum": ["first", "cycle", "random"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
