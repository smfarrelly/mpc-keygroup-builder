{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smfarrelly/mpc-keygroup-builder/blob/main/src/mpc_keygroup_builder/data/schemas/harmony-recipe.schema.json",
  "title": "Harmony and Bass recipe",
  "type": "object",
  "required": ["schema_version", "id", "name", "key", "scale", "bars", "progression", "chord_range", "bass_range"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "key": {"type": "string", "pattern": "^[A-Ga-g](#|b)?$"},
    "scale": {"enum": ["major", "minor", "dorian", "mixolydian"]},
    "bars": {"type": "integer", "minimum": 1, "maximum": 64},
    "beats_per_bar": {"type": "integer", "minimum": 2, "maximum": 8},
    "progression": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1, "maximum": 7}},
    "chord_beats": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
    "chord_notes": {"enum": [3, 4]},
    "chord_range": {"$ref": "#/$defs/range"},
    "bass_range": {"$ref": "#/$defs/range"},
    "bass_pattern": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": -24, "maximum": 24}},
    "bass_steps_per_beat": {"enum": [1, 2, 4]},
    "chord_velocity": {"type": "integer", "minimum": 1, "maximum": 127},
    "bass_velocity": {"type": "integer", "minimum": 1, "maximum": 127},
    "gate": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "humanize_velocity": {"type": "integer", "minimum": 0, "maximum": 32},
    "chord_channel": {"type": "integer", "minimum": 1, "maximum": 16},
    "bass_channel": {"type": "integer", "minimum": 1, "maximum": 16}
  },
  "$defs": {
    "range": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 127}, {"type": "integer", "minimum": 0, "maximum": 127}], "minItems": 2, "maxItems": 2}
  },
  "additionalProperties": false
}
