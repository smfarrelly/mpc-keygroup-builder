{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smfarrelly/mpc-keygroup-builder/blob/main/src/mpc_keygroup_builder/data/schemas/kit-recipe.schema.json",
  "title": "Cross-library semantic Drum kit recipe",
  "type": "object",
  "required": ["schema_version", "id", "name", "seed", "pads"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "require_hardware_pass": {"type": "boolean"},
    "pads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pad", "role"],
        "properties": {
          "pad": {"type": "integer", "minimum": 1, "maximum": 128},
          "role": {"type": "string", "minLength": 1},
          "mute_group": {"type": "integer", "minimum": 0, "maximum": 32},
          "prefer_duration": {"enum": ["short", "medium", "long"]},
          "prefer_loudness": {"enum": ["silent", "quiet", "moderate", "loud"]},
          "prefer_transient": {"enum": ["soft", "defined", "sharp"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
