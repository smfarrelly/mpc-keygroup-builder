{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smfarrelly/mpc-keygroup-builder/blob/main/src/mpc_keygroup_builder/data/schemas/plugin-profile.schema.json",
  "title": "Launch Control plugin performance profile",
  "type": "object",
  "required": ["schema_version", "id", "name", "description", "slot", "channel", "controls"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "plugin": {"type": "string", "minLength": 1},
    "plugins": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "slot": {"type": "integer", "minimum": 1, "maximum": 15},
    "channel": {"type": "integer", "minimum": 1, "maximum": 16},
    "probe": {"$ref": "#/$defs/endpoint"},
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["control", "ui_parameter", "name"],
        "properties": {
          "control": {"$ref": "#/$defs/endpoint"},
          "plugin": {"type": "string", "minLength": 1},
          "ui_parameter": {"type": "integer", "minimum": 0},
          "name": {"type": "string", "minLength": 1},
          "label": {"type": "string", "maxLength": 16},
          "role": {"type": "string"},
          "priority": {"enum": ["core", "secondary"]},
          "color": {"type": "string"},
          "behavior": {"enum": ["absolute", "toggle", "momentary"]}
        },
        "additionalProperties": true
      }
    }
  },
  "oneOf": [{"required": ["plugin"]}, {"required": ["plugins"]}],
  "$defs": {
    "endpoint": {
      "type": "string",
      "pattern": "^(top-encoder|middle-encoder|bottom-encoder|fader|upper-button|lower-button)-[1-8]$"
    }
  },
  "additionalProperties": true
}
