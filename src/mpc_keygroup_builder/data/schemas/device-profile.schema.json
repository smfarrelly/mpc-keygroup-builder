{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smfarrelly/mpc-keygroup-builder/blob/main/src/mpc_keygroup_builder/data/schemas/device-profile.schema.json",
  "title": "MPC device profile",
  "type": "object",
  "required": ["schema_version", "id", "name", "keys", "pad_rows", "pad_columns", "banks"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "keys": {"type": "integer", "minimum": 0},
    "pad_rows": {"type": "integer", "minimum": 1},
    "pad_columns": {"type": "integer", "minimum": 1},
    "banks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": true
}
