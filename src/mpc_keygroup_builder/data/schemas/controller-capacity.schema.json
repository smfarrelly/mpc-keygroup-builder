{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smfarrelly/mpc-keygroup-builder/blob/main/src/mpc_keygroup_builder/data/schemas/controller-capacity.schema.json",
  "title": "Launch Control Custom Mode capacity plan",
  "type": "object",
  "required": ["schema_version", "name", "control_channel", "external_channels", "modes"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "control_channel": {"type": "integer", "minimum": 1, "maximum": 16},
    "external_channels": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 16}
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slot", "name", "channel", "role", "source"],
        "properties": {
          "slot": {"type": "integer", "minimum": 1, "maximum": 15},
          "name": {"type": "string", "minLength": 1},
          "channel": {"type": "integer", "minimum": 1, "maximum": 16},
          "role": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "capture_name": {"type": "string"},
          "slot_evidence": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
